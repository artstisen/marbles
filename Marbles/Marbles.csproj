<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>1.5.3.0</AssemblyVersion>
        <FileVersion>1.5.3.0</FileVersion>
        <!-- No dependency on the ICU libraries of the system (needed for the self-contained Linux builds) -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Marbles.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The translations of the texts (see Lang.cs) -->
        <EmbeddedResource Include="Lang\*.txt" LogicalName="Marbles.Lang.%(Filename).txt" />
        <!-- The other languages: files in the folder "lang" next to the program, which users can change -->
        <None Include="Lang\External\*.txt" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

</Project>
