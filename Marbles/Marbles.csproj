<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>1.5.4.0</AssemblyVersion>
        <FileVersion>1.5.4.0</FileVersion>
        <!-- The program icon, made from resources/Marbles.svg (16 to 256 pixels) -->
        <ApplicationIcon>Marbles.ico</ApplicationIcon>
        <!-- No dependency on the ICU libraries of the system (needed for the self-contained Linux builds) -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Marbles.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The texts of this version, in English (made by tools/langfile.py), to count how much of a language file is translated (see Lang.cs) -->
        <EmbeddedResource Include="Lang\texts.txt" LogicalName="Marbles.Lang.texts.txt" />
        <!-- The built-in color schemes (see ColorScheme.BuiltIn) -->
        <EmbeddedResource Include="Schemes\*.txt" LogicalName="Marbles.Schemes.%(Filename).txt" />
        <!-- The languages: files in the folder "lang" next to the program, which users can change -->
        <None Include="Lang\External\*.txt" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

</Project>
